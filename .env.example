# Ganti rms_db dengan nama database kosong yang sudah Anda buat di MySQL.
# Tanpa password (XAMPP default): mysql://root@localhost:3306/rms_db
# Dengan password:               mysql://root:PASSWORD@localhost:3306/rms_db
DATABASE_URL=mysql://root@localhost:3306/rms_db

# Isi dengan string acak yang panjang. Jangan pakai nilai contoh ini.
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
